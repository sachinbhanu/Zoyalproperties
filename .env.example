# ---- Single source of configuration (edit only this file) ----

# Dev / production server port (used by `npm run dev` and `npm start`)
PORT=4000

# Contact number: international format, digits only (no "+", spaces or dashes).
# Used everywhere on the site: WhatsApp links, call buttons, footer, contact page, JSON-LD.
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Public site URL (sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:4000
